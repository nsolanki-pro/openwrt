+/*
+ * mtk-8021q: the CPU port carries 802.1Q tags instead of the MediaTek
+ * special tag, using tag_8021q's VLANs: every user port and the CPU port
+ * forward by VLAN table (security mode); each tag_8021q VLAN is the PVID
+ * of its user port, egress-untagged there and egress-tagged towards the
+ * CPU. Lets a MAC-side engine that only understands 802.1Q (the
+ * SF19A2890 GMAC's NAT offload) parse the frames. VLAN-unaware bridging
+ * only.
+ */
+static int mt7530_tag_8021q_vlan_add(struct dsa_switch *ds, int port, u16 vid,
+				     u16 flags)
+{
+	bool untagged = flags & BRIDGE_VLAN_INFO_UNTAGGED;
+	struct mt7530_priv *priv = ds->priv;
+	u32 val, members;
+	int ret;
+
+	mutex_lock(&priv->reg_mutex);
+
+	ret = mt7530_vlan_cmd(priv, MT7530_VTCR_RD_VID, vid);
+	if (ret)
+		goto out;
+
+	val = mt7530_read(priv, MT7530_VAWD1);
+	members = ((val & VLAN_VALID) ? (val >> PORT_MEM_SHFT) & PORT_MEM_MASK : 0) |
+		  BIT(port);
+	if (!(val & VLAN_VALID))
+		mt7530_write(priv, MT7530_VAWD2, 0);
+	mt7530_write(priv, MT7530_VAWD1, IVL_MAC | VTAG_EN | PORT_MEM(members) |
+		     FID(FID_BRIDGED) | VLAN_VALID);
+	mt7530_rmw(priv, MT7530_VAWD2, ETAG_CTRL_P_MASK(port),
+		   ETAG_CTRL_P(port, untagged ? MT7530_VLAN_EGRESS_UNTAG :
+						MT7530_VLAN_EGRESS_TAG));
+
+	ret = mt7530_vlan_cmd(priv, MT7530_VTCR_WR_VID, vid);
+	if (ret)
+		goto out;
+
+	if (flags & BRIDGE_VLAN_INFO_PVID) {
+		priv->ports[port].pvid_8021q = vid;
+		mt7530_rmw(priv, MT7530_PPBV1_P(port), G0_PORT_VID_MASK,
+			   G0_PORT_VID(vid));
+	}
+out:
+	mutex_unlock(&priv->reg_mutex);
+	return ret;
+}
+
+static int mt7530_tag_8021q_vlan_del(struct dsa_switch *ds, int port, u16 vid)
+{
+	struct mt7530_priv *priv = ds->priv;
+	u32 val, members;
+	int ret;
+
+	mutex_lock(&priv->reg_mutex);
+
+	ret = mt7530_vlan_cmd(priv, MT7530_VTCR_RD_VID, vid);
+	if (ret)
+		goto out;
+
+	val = mt7530_read(priv, MT7530_VAWD1);
+	members = (val & VLAN_VALID) ?
+		  ((val >> PORT_MEM_SHFT) & PORT_MEM_MASK) & ~BIT(port) : 0;
+	if (members) {
+		mt7530_write(priv, MT7530_VAWD1, IVL_MAC | VTAG_EN |
+			     PORT_MEM(members) | FID(FID_BRIDGED) | VLAN_VALID);
+	} else {
+		mt7530_write(priv, MT7530_VAWD1, 0);
+		mt7530_write(priv, MT7530_VAWD2, 0);
+	}
+	ret = mt7530_vlan_cmd(priv, MT7530_VTCR_WR_VID, vid);
+
+	if (priv->ports[port].pvid_8021q == vid) {
+		priv->ports[port].pvid_8021q = 0;
+		mt7530_rmw(priv, MT7530_PPBV1_P(port), G0_PORT_VID_MASK,
+			   G0_PORT_VID_DEF);
+	}
+out:
+	mutex_unlock(&priv->reg_mutex);
+	return ret;
+}
+
+static void mt7530_set_8021q_port_mode(struct mt7530_priv *priv, bool on)
+	__must_hold(&priv->reg_mutex)
+{
+	struct dsa_switch *ds = priv->ds;
+	struct dsa_port *dp;
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		/* mt7530_port_enable() rewrites a port's matrix from the
+		 * cached pm, which the MTK-tag setup never fills in for the
+		 * CPU port (its frames carry an explicit port bitmap). With
+		 * 802.1Q the CPU port forwards by matrix + VLAN table, so
+		 * keep it connected to every user port.
+		 */
+		priv->ports[dp->index].pm = on ?
+			PCR_MATRIX(dsa_user_ports(ds)) : 0;
+		mt7530_rmw(priv, MT7530_PCR_P(dp->index), PCR_MATRIX_MASK,
+			   PCR_MATRIX(dsa_user_ports(ds)));
+
+		/* PVC[31:16] is the TPID the port matches 802.1Q tags
+		 * against; the MTK-tag setup leaves it 0, which makes the
+		 * port drop every tagged frame from the CPU (RxFiltering)
+		 */
+		if (on)
+			mt7530_write(priv, MT7530_PVC_P(dp->index),
+				     MT7530_PVC_TPID(ETH_P_8021Q) |
+				     VLAN_ATTR(MT7530_VLAN_USER) |
+				     PVC_EG_TAG(MT7530_VLAN_EG_DISABLED));
+		else
+			mt7530_write(priv, MT7530_PVC_P(dp->index),
+				     PORT_SPEC_TAG |
+				     PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT));
+		mt7530_rmw(priv, MT7530_PCR_P(dp->index), PCR_PORT_VLAN_MASK,
+			   on ? MT7530_PORT_SECURITY_MODE :
+				MT7530_PORT_FALLBACK_MODE);
+		/* DSA never sets an STP state on the CPU port: with the MTK
+		 * tag its frames carry a port bitmap and bypass the VLAN/STP
+		 * lookup, with 802.1Q they don't. Forward in the FID the
+		 * tag_8021q VLANs use.
+		 */
+		if (on)
+			mt7530_rmw(priv, MT7530_SSP_P(dp->index),
+				   FID_PST_MASK(FID_BRIDGED),
+				   FID_PST(FID_BRIDGED, MT7530_STP_FORWARDING));
+	}
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (on) {
+			mt7530_rmw(priv, MT7530_PCR_P(dp->index),
+				   PCR_PORT_VLAN_MASK, MT7530_PORT_SECURITY_MODE);
+			mt7530_rmw(priv, MT7530_PVC_P(dp->index),
+				   VLAN_ATTR_MASK | PVC_EG_TAG_MASK | ACC_FRM_MASK,
+				   VLAN_ATTR(MT7530_VLAN_USER) |
+				   PVC_EG_TAG(MT7530_VLAN_EG_DISABLED) |
+				   MT7530_VLAN_ACC_ALL);
+		} else {
+			mt7530_rmw(priv, MT7530_PCR_P(dp->index),
+				   PCR_PORT_VLAN_MASK,
+				   dsa_port_bridge_dev_get(dp) ?
+				   MT7530_PORT_FALLBACK_MODE :
+				   MT7530_PORT_MATRIX_MODE);
+			mt7530_rmw(priv, MT7530_PVC_P(dp->index),
+				   VLAN_ATTR_MASK | PVC_EG_TAG_MASK | ACC_FRM_MASK,
+				   VLAN_ATTR(MT7530_VLAN_TRANSPARENT) |
+				   PVC_EG_TAG(MT7530_VLAN_EG_CONSISTENT) |
+				   MT7530_VLAN_ACC_ALL);
+			mt7530_rmw(priv, MT7530_PPBV1_P(dp->index),
+				   G0_PORT_VID_MASK, G0_PORT_VID_DEF);
+		}
+	}
+}
+
+static int mt7530_change_tag_protocol(struct dsa_switch *ds,
+				      enum dsa_tag_protocol proto)
+{
+	struct mt7530_priv *priv = ds->priv;
+	bool want_8021q;
+	struct dsa_port *dp;
+	int err;
+
+	switch (proto) {
+	case DSA_TAG_PROTO_MTK:
+		want_8021q = false;
+		break;
+	case DSA_TAG_PROTO_MTK_8021Q:
+		/* only brought up on the MT7530 */
+		if (priv->id != ID_MT7530 && priv->id != ID_MT7621)
+			return -EPROTONOSUPPORT;
+		want_8021q = true;
+		break;
+	default:
+		return -EPROTONOSUPPORT;
+	}
+
+	if (want_8021q == priv->tag_8021q)
+		return 0;
+
+	/* tag_8021q VLANs are only installed at setup and bridge join */
+	dsa_switch_for_each_user_port(dp, ds)
+		if (dsa_port_bridge_dev_get(dp))
+			return -EBUSY;
+
+	if (want_8021q) {
+		mutex_lock(&priv->reg_mutex);
+		mt7530_set_8021q_port_mode(priv, true);
+		mutex_unlock(&priv->reg_mutex);
+
+		priv->tag_8021q = true;
+		ds->max_num_bridges = DSA_TAG_8021Q_MAX_NUM_BRIDGES;
+
+		err = dsa_tag_8021q_register(ds, htons(ETH_P_8021Q));
+		if (err) {
+			priv->tag_8021q = false;
+			ds->max_num_bridges = 0;
+			mutex_lock(&priv->reg_mutex);
+			mt7530_set_8021q_port_mode(priv, false);
+			mutex_unlock(&priv->reg_mutex);
+			return err;
+		}
+	} else {
+		dsa_tag_8021q_unregister(ds);
+		priv->tag_8021q = false;
+		ds->max_num_bridges = 0;
+
+		mutex_lock(&priv->reg_mutex);
+		mt7530_set_8021q_port_mode(priv, false);
+		mutex_unlock(&priv->reg_mutex);
+	}
+
+	return 0;
+}

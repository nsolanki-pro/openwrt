 net/dsa/Kconfig         |  8 ++++
 net/dsa/Makefile        |  1 +
 net/dsa/tag_mtk_8021q.c | 94 +++++++++++++++++++++++++++++++++++++++++
 4 files changed, 105 insertions(+)
 create mode 100644 net/dsa/tag_mtk_8021q.c


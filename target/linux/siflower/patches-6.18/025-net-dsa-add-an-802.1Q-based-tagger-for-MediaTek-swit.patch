--- /dev/null
+++ b/net/dsa/tag_mtk_8021q.c
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+/*
+ * DSA tagger for MediaTek MT7530 switches using 802.1Q VLAN tags
+ * (tag_8021q) instead of the MediaTek special tag. Modelled on
+ * tag_vsc73xx_8021q.c.
+ */
+#include <linux/dsa/8021q.h>
+
+#include "tag.h"
+#include "tag_8021q.h"
+
+#define MTK_8021Q_NAME "mtk-8021q"
+
+static struct sk_buff *mtk_8021q_xmit(struct sk_buff *skb,
+				      struct net_device *netdev)
+{
+	struct dsa_port *dp = dsa_user_to_port(netdev);
+	u16 queue_mapping = skb_get_queue_mapping(skb);
+	u16 tx_vid = dsa_tag_8021q_standalone_vid(dp);
+	u8 pcp;
+
+	/* offload_fwd_mark survives forwarding paths that never pass the
+	 * bridge -- e.g. a frame received on a bridged port and sent by the
+	 * flowtable's direct xmit through a standalone port -- so it only
+	 * means "the hardware may forward this" when the port is bridged
+	 */
+	if (skb->offload_fwd_mark && dsa_port_bridge_dev_get(dp)) {
+		unsigned int bridge_num = dsa_port_bridge_num_get(dp);
+		struct net_device *br = dsa_port_bridge_dev_get(dp);
+
+		if (br_vlan_enabled(br))
+			return skb;
+
+		tx_vid = dsa_tag_8021q_bridge_vid(bridge_num);
+	}
+
+	pcp = netdev_txq_to_tc(netdev, queue_mapping);
+
+	return dsa_8021q_xmit(skb, netdev, ETH_P_8021Q,
+			      ((pcp << VLAN_PRIO_SHIFT) | tx_vid));
+}
+
+static struct sk_buff *mtk_8021q_rcv(struct sk_buff *skb,
+				     struct net_device *netdev)
+{
+	int src_port = -1, switch_id = -1, vbid = -1, vid = -1;
+
+	dsa_8021q_rcv(skb, &src_port, &switch_id, &vbid, &vid);
+
+	skb->dev = dsa_tag_8021q_find_user(netdev, src_port, switch_id,
+					   vid, vbid);
+	if (!skb->dev) {
+		dev_warn_ratelimited(&netdev->dev,
+				     "Couldn't decode source port\n");
+		return NULL;
+	}
+
+	dsa_default_offload_fwd_mark(skb);
+
+	return skb;
+}
+
+/* The generic DSA flow dissector skips needed_headroom bytes as if the
+ * 802.1Q tag were still in the packet data; when the conduit strips it in
+ * hardware (rx-vlan-offload) that lands inside the IP header, every flow
+ * hashes the same and RPS piles all receive work onto one CPU.
+ */
+static void mtk_8021q_flow_dissect(const struct sk_buff *skb, __be16 *proto,
+				   int *offset)
+{
+	if (skb_vlan_tag_present(skb)) {
+		*offset = 0;
+		*proto = eth_hdr(skb)->h_proto;
+		return;
+	}
+
+	dsa_tag_generic_flow_dissect(skb, proto, offset);
+}
+
+static const struct dsa_device_ops mtk_8021q_netdev_ops = {
+	.name			= MTK_8021Q_NAME,
+	.proto			= DSA_TAG_PROTO_MTK_8021Q,
+	.xmit			= mtk_8021q_xmit,
+	.rcv			= mtk_8021q_rcv,
+	.flow_dissect		= mtk_8021q_flow_dissect,
+	.needed_headroom	= VLAN_HLEN,
+	.promisc_on_conduit	= true,
+};
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("DSA tag driver for MediaTek switches, using VLAN");
+MODULE_ALIAS_DSA_TAG_DRIVER(DSA_TAG_PROTO_MTK_8021Q, MTK_8021Q_NAME);
+
+module_dsa_tag_driver(mtk_8021q_netdev_ops);

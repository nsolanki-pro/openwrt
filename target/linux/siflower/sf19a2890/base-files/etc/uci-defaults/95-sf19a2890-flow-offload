#!/bin/sh
# Flow offloading for forwarded traffic: the software fast path for
# everything, plus hardware offload of wired LAN <-> WAN NAT flows to the
# SF19A2890 HNAT engine in the GMAC (WiFi and IPv6 flows stay in software).
uci -q get firewall.@defaults[0].flow_offloading >/dev/null && exit 0
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'
uci commit firewall
exit 0
